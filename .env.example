# Copiá este archivo a ".env" y ajustá los valores para tu entorno.
# ".env" nunca debe subirse a Git (ya está en .gitignore).

# Clave secreta de Flask, usada para firmar la sesión y las cookies.
# Generá una propia en producción, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-en-produccion

# Cadena de conexión a la base de datos.
# Dejala comentada en desarrollo: app/config.py ya arma una ruta SQLite
# absoluta dentro de instance/ por defecto. Si escribís acá una ruta SQLite
# relativa (sqlite:///archivo.db) puede terminar creando un archivo distinto
# según desde dónde se ejecute el proyecto, así que solo se recomienda
# definir esta variable al migrar a PostgreSQL, por ejemplo:
# DATABASE_URL=postgresql://usuario:password@host:5432/trabajitos

# Activa el modo debug de Flask (recarga automática, mensajes de error
# detallados). Usar "1" en desarrollo y "0" en producción.
FLASK_DEBUG=1
